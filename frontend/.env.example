# FastAPI origin. Server-only: read by lib/server/backend.ts inside the
# /api/* Route Handlers, never shipped to the browser.
API_URL=http://localhost:8010

# Legacy fallback, still honoured by lib/server/backend.ts when API_URL is
# unset. Prefer API_URL — anything NEXT_PUBLIC_* is inlined into client
# bundles, and the browser no longer needs to know the backend origin: it
# talks to this app's same-origin /api/* routes.
# NEXT_PUBLIC_API_URL=http://localhost:8010
