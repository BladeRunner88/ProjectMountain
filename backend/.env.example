# Copy to backend/.env and adjust. Never commit .env — it is gitignored.
# Every variable the backend reads appears here (AGENTS.md 5).

ISILDUR_PROJECT_NAME="Isildur ASE API"
ISILDUR_VERSION="0.2.0"

# local | staging | production. `local` enables /docs and /openapi.json.
ISILDUR_ENVIRONMENT=local

ISILDUR_API_PREFIX=/api/v1

# The API-owned, read-write DuckDB file. Alembic's only target.
# Do not name it app.duckdb: DuckDB derives the catalog name from the file stem, and a
# catalog called `app` is ambiguous with the `app` schema inside it.
ISILDUR_APP_DB_PATH=data/isildur_app.duckdb

# What the API READS. Opened read-only, never written by the API.
ISILDUR_WAREHOUSE_DB_PATH=data/warehouse.duckdb

# What the pipeline WRITES. Kept separate from the above so a rebuild cannot overwrite
# the database currently being served; point both at this file to serve the new one.
ISILDUR_PIPELINE_OUTPUT_PATH=data/warehouse.duckdb

# Cap it. DuckDB will otherwise take the whole box on a large aggregate and be OOM-killed.
ISILDUR_DUCKDB_MEMORY_LIMIT=2GB
ISILDUR_DUCKDB_THREADS=4

# Threadpool size for `def` handlers. Starlette's default of 40 produces write conflicts
# against a single-writer database (AGENTS.md 4.2).
ISILDUR_THREADPOOL_SIZE=8

# Explicit browser-origin allowlist. Never "*" with allow_credentials.
ISILDUR_CORS_ORIGINS=http://localhost:3000

ISILDUR_LOG_LEVEL=INFO
